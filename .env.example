# NAS 对外端口
APP_PORT=3000

# 由 GitHub Actions 发布到 GHCR 的镜像。通常无需修改。
IMAGE=ghcr.io/jeck5001/jia-pai:latest

# 服务端调用视觉模型。不要把 API Key 写进前端或提交到版本库。
SUB2API_BASE_URL=http://192.168.5.35:8084/
# 默认识别模型；页面上的模型下拉列表会实时读取 Sub2API 的可用模型，缺省选中此项。
SUB2API_MODEL=gpt-5.5
SUB2API_API_KEY=
# 单次识别允许模型输出的最大 token 数。默认 16000。整张价格表的商品行很多时，这个值太小会导致
# JSON 被截断（页面提示“不是有效 JSON”或“输出被截断”）。若某个模型不支持这么大的输出上限并返回
# HTTP 400，请逐步调小此项。
SUB2API_MAX_TOKENS=16000
# 单张照片识别的最长等待时间，单位毫秒。默认 180000（3 分钟）。
SUB2API_TIMEOUT_MS=180000

# 留空表示内网中任何访问者都能发布价格表。建议设置为随机长字符串。
ADMIN_TOKEN=
